# systemd — mantém a API rodando e reinicia se cair.
# Instalação:
#   sudo cp deploy/porondeapi.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now porondeapi
# Logs:  journalctl -u porondeapi -f
#
# Ajuste User e os caminhos se instalar em outra pasta.

[Unit]
Description=Por Onde API (FastAPI)
After=network.target postgresql.service

[Service]
User=www-data
WorkingDirectory=/opt/ondeestou
ExecStart=/opt/ondeestou/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

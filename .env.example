# Copie para .env e preencha:   cp .env.example .env
# O arquivo .env NUNCA deve ir para o Git (já está no .gitignore).

DB_HOST=localhost            # na própria VPS use localhost; de fora, o nome do servidor
DB_PORT=5432
DB_NAME=localizacao
DB_USER=localizacao
DB_PASSWORD=
DB_SSLMODE=prefer

# Identificação exigida pela Wikipedia (coloque um e-mail ou site de contato)
USER_AGENT=PorOndeApp/0.1 (seu-email@exemplo.com)

# Open-Meteo: vazio = plano gratuito (somente uso NÃO comercial, até 10 mil chamadas/dia).
OPEN_METEO_API_KEY=

# Ajustes opcionais
CACHE_CLIMA_MIN=30
CACHE_CIDADE_DIAS=30
RAIO_PROXIMA_CIDADE_M=80000
DIST_NUCLEO_M=200           # pedaços urbanos a até essa distância formam um núcleo
ANGULO_MAX_GRAUS=45
VELOCIDADE_PADRAO_KMH=70
FATOR_ESTRADA=1.25

# População (API de agregados do IBGE) — confira a tabela se a importação avisar erro
IBGE_TABELA_POP=4714
IBGE_VARIAVEL_POP=93
IBGE_PERIODO_POP=2022

# Nomes das colunas nos shapefiles do IBGE (o importador lista as colunas se errar)
CAMPO_BIOMA=Bioma
CAMPO_RELEVO=NOM_UNIDAD
CAMPO_RELEVO_DESC=DSC_COMPAR

# Importação (scripts/importar_tudo.py): estados e regiões do OpenStreetMap
IMPORTAR_UFS=PE PB AL RN CE BA SE PI MA
OSM_REGIOES=nordeste
